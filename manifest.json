{
  "manifest_version": 3,
  "name": "flomo 彩色标签",
  "description": "在 flomo 网页端按标签显示稳定、可自定义的颜色。所有处理均在本地完成。",
  "version": "0.3.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://flomoapp.com/*",
        "https://*.flomoapp.com/*"
      ],
      "css": ["src/content.css"],
      "js": [
        "src/tag-colors.js",
        "src/tag-detection.js",
        "src/tag-rendering.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
